; Defined, in-range inputs only: compare stdout before and after rewriting.
@ints = internal addrspace(2) constant [7 x i32] [i32 0, i32 1, i32 -1, i32 -2147483648, i32 2147483647, i32 305419896, i32 42]
@floats = internal addrspace(2) constant [7 x float] [float 0.0, float -0.0, float 1.0, float -1.0, float 0x7FF0000000000000, float 0x7FF8000000000000, float 0x7FF8000020000000]
@small = internal addrspace(2) constant [8 x i8] [i8 -128, i8 -127, i8 -126, i8 -125, i8 -124, i8 -123, i8 -122, i8 -121]
@wide = internal addrspace(2) constant [16 x i64] [i64 4096, i64 4097, i64 4098, i64 4099, i64 4100, i64 4101, i64 4102, i64 4103, i64 4104, i64 4105, i64 4106, i64 4107, i64 4108, i64 4109, i64 4110, i64 4111]
@too_narrow = internal addrspace(2) constant [9 x i8] [i8 0, i8 1, i8 2, i8 3, i8 4, i8 5, i8 6, i8 7, i8 8]
@single = internal addrspace(2) constant [1 x i32] [i32 9]
@oversized = internal addrspace(2) constant [17 x i32] [i32 1, i32 2, i32 3, i32 4, i32 5, i32 6, i32 7, i32 8, i32 9, i32 10, i32 11, i32 12, i32 13, i32 14, i32 15, i32 16, i32 17]
@widefmt = private unnamed_addr constant [14 x i8] c"%016llx %02x\0A\00"
@fmt = private unnamed_addr constant [11 x i8] c"%08x %08x\0A\00"
declare i32 @printf(i8*, ...)

define i32 @read_int(i64 %i) {
  %ptr = getelementptr [7 x i32], [7 x i32] addrspace(2)* @ints, i64 0, i64 %i
  %value = load i32, i32 addrspace(2)* %ptr
  ret i32 %value
}
define float @read_float(i64 %i) {
  %ptr = getelementptr [7 x float], [7 x float] addrspace(2)* @floats, i64 0, i64 %i
  %value = load float, float addrspace(2)* %ptr
  ret float %value
}
define i8 @read_i4(i4 %i) {
  %ptr = getelementptr [8 x i8], [8 x i8] addrspace(2)* @small, i64 0, i4 %i
  %value = load i8, i8 addrspace(2)* %ptr
  ret i8 %value
}
define i64 @read_i8(i8 %i) {
  %ptr = getelementptr inbounds [16 x i64], [16 x i64] addrspace(2)* @wide, i64 0, i8 %i
  %value = load i64, i64 addrspace(2)* %ptr
  ret i64 %value
}
define i8 @reject_i4(i4 %i) {
  %ptr = getelementptr [9 x i8], [9 x i8] addrspace(2)* @too_narrow, i64 0, i4 %i
  %value = load i8, i8 addrspace(2)* %ptr
  ret i8 %value
}
define i32 @reject_single(i64 %i) {
  %ptr = getelementptr [1 x i32], [1 x i32] addrspace(2)* @single, i64 0, i64 %i
  %value = load i32, i32 addrspace(2)* %ptr
  ret i32 %value
}
define i32 @reject_oversized(i64 %i) {
  %ptr = getelementptr [17 x i32], [17 x i32] addrspace(2)* @oversized, i64 0, i64 %i
  %value = load i32, i32 addrspace(2)* %ptr
  ret i32 %value
}
define i8 @reject_volatile(i4 %i) {
  %ptr = getelementptr [8 x i8], [8 x i8] addrspace(2)* @small, i64 0, i4 %i
  %value = load volatile i8, i8 addrspace(2)* %ptr
  ret i8 %value
}
define i32 @main() {
entry:
  br label %loop
loop:
  %i = phi i64 [0, %entry], [%next, %loop]
  %a = call i32 @read_int(i64 %i)
  %b = call float @read_float(i64 %i)
  %bits = bitcast float %b to i32
  %fmtptr = getelementptr [11 x i8], [11 x i8]* @fmt, i64 0, i64 0
  %printed = call i32 (i8*, ...) @printf(i8* %fmtptr, i32 %a, i32 %bits)
  %next = add i64 %i, 1
  %more = icmp ult i64 %next, 7
  br i1 %more, label %loop, label %done
done:
  br label %wide_loop
wide_loop:
  %j = phi i32 [0, %done], [%jnext, %wide_loop]
  %narrow8 = trunc i32 %j to i8
  %masked = and i32 %j, 7
  %narrow4 = trunc i32 %masked to i4
  %large_value = call i64 @read_i8(i8 %narrow8)
  %small_value = call i8 @read_i4(i4 %narrow4)
  %small_extended = zext i8 %small_value to i32
  %widefmtptr = getelementptr [14 x i8], [14 x i8]* @widefmt, i64 0, i64 0
  %wideprinted = call i32 (i8*, ...) @printf(i8* %widefmtptr, i64 %large_value, i32 %small_extended)
  %jnext = add i32 %j, 1
  %again = icmp ult i32 %jnext, 16
  br i1 %again, label %wide_loop, label %end
end:
  ret i32 0
}
